import { Button, CheckBox, ComboBox, LineEdit, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

// A content-sized pill: height follows the text, so labels never clip.
component Pill inherits Rectangle {
    in property <string> text;
    in property <color> fg: #3f3f46;
    border-radius: 13px;
    border-width: 1px;
    border-color: #e4e4e7;
    background: #f4f4f5;
    horizontal-stretch: 0;
    label := Text {
        text: root.text;
        color: root.fg;
        font-size: 12px;
        vertical-alignment: center;
    }
    // Size to the text plus padding.
    min-width: label.preferred-width + 20px;
    min-height: 26px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Rectangle { } // let the label center
    }
}

// Label and value cells of the status grid; values wrap instead of clipping
// when the window is narrow.
component InfoLabel inherits Text {
    font-size: 12px;
    color: #71717a;
    vertical-alignment: top;
}

component InfoValue inherits Text {
    font-size: 12px;
    color: #09090b;
    wrap: word-wrap;
    horizontal-stretch: 1;
}

component Card inherits Rectangle {
    background: #ffffff;
    border-color: #e4e4e7;
    border-width: 1px;
    border-radius: 12px;
    drop-shadow-blur: 8px;
    drop-shadow-color: #0000000f;
    drop-shadow-offset-y: 2px;
}

export component MainWindow inherits Window {
    title: "机房学生端";
    // Resizable: start at the preferred size. The minimum height comes from
    // the content (wrapped text grows when narrow), so nothing gets clipped.
    preferred-width: 460px;
    preferred-height: 760px;
    min-width: 360px;
    background: #fafafa;
    icon: root.app-icon;

    in property <image> app-icon;
    in property <bool> locked: true;
    in property <bool> first-run: false;
    in property <string> hostname: "";
    in property <bool> uwf-on: false;
    in property <string> uwf-text: "未知";
    // Full UWF error text, if any (the pill only says that it failed).
    in property <string> uwf-detail: "";
    in property <bool> wallpaper-locked: false;
    in property <string> usb-text: "—";
    in property <string> rev-text: "策略 rev 0";
    in property <bool> busy: false;
    in-out property <bool> admin-dialog-open: false;
    in-out property <bool> admin-mode: false;
    in-out property <string> admin-password;
    in property <string> admin-error;
    in-out property <bool> admin-lock-wallpaper: false;
    in-out property <string> admin-wallpaper-path;
    in-out property <string> admin-usb: "禁用";
    in-out property <string> admin-uwf: "开启";
    in-out property <string> admin-uwf-scope: "仅系统盘";
    in-out property <bool> admin-task-manager: false;
    in-out property <bool> admin-block-internet: false;
    in-out property <string> admin-new-passphrase;
    in-out property <string> admin-default-wallpaper-path;
    in-out property <string> message: "";

    callback unlock(string);
    callback hide-window();
    callback about-clicked();
    callback admin-unlock(string);
    callback admin-save();
    callback admin-restore();
    callback admin-defaults();
    callback try-submit();

    in-out property <string> pw;
    in-out property <string> pw2;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // ---- Header ----
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 42px; height: 42px; border-radius: 10px; background: #18181b;
                Text { text: "LC"; color: white; font-weight: 700; font-size: 16px;
                       horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout {
                alignment: center; spacing: 3px;
                Text { text: "机房学生端"; font-size: 17px; font-weight: 700; color: #09090b; }
                Text { text: "受教师端统一管理 · 本机房内网"; font-size: 12px; color: #71717a; }
            }
        }

        // ---- Lock gate ----
        if root.locked : Card {
            vertical-stretch: 0;   // keep its natural height in tall windows
            VerticalLayout {
                padding: 20px; spacing: 14px;
                Text {
                    text: root.first-run ? "首次使用，请设置访问密码" : "请输入访问密码";
                    font-size: 15px; font-weight: 600; color: #09090b;
                }
                Text {
                    text: root.first-run ? "设置后，每次打开本程序都需输入该密码。"
                                         : "输入密码后方可查看与操作。";
                    font-size: 12px; color: #71717a; wrap: word-wrap;
                }
                LineEdit {
                    height: 36px;
                    placeholder-text: "访问密码";
                    input-type: password;
                    text <=> root.pw;
                    accepted => { root.try-submit(); }
                }
                if root.first-run : LineEdit {
                    height: 36px;
                    placeholder-text: "再次输入确认";
                    input-type: password;
                    text <=> root.pw2;
                    accepted => { root.try-submit(); }
                }
                if root.message != "" : Text {
                    text: root.message; color: #dc2626; font-size: 12px; wrap: word-wrap;
                }
                Button {
                    height: 38px;
                    text: root.first-run ? "设置并进入" : "解锁";
                    primary: true;
                    enabled: !root.busy;
                    clicked => { root.try-submit(); }
                }
            }
        }

        // Tall windows: the extra space goes below the lock card.
        if root.locked : Rectangle { vertical-stretch: 1; }

        // ---- Main panel ----
        if !root.locked : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
            spacing: 16px;

            Card {
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "UWF 写入筛选器"; font-size: 14px; font-weight: 600;
                               color: #09090b; vertical-alignment: center;
                               horizontal-stretch: 1; }
                        Pill { text: root.uwf-text; fg: root.uwf-on ? #16a34a : #71717a; }
                    }
                    if root.uwf-detail != "" : Rectangle {
                        background: #fef2f2; border-radius: 8px;
                        border-width: 1px; border-color: #fecaca;
                        HorizontalLayout {
                            padding: 10px;
                            Text { text: root.uwf-detail; font-size: 12px; color: #b91c1c; wrap: word-wrap; }
                        }
                    }
                    Text {
                        text: "开启后受保护磁盘的改动会在重启后被丢弃（还原）。";
                        font-size: 12px; color: #71717a; wrap: word-wrap;
                    }
                    Rectangle {
                        background: #f4f4f5; border-radius: 8px;
                        HorizontalLayout {
                            padding: 10px;
                            Text { text: "UWF 由教师端统一控制，本机仅显示状态。";
                                   font-size: 12px; color: #52525b; wrap: word-wrap; }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: 16px; spacing: 12px;
                    Text { text: "本机状态"; font-size: 14px; font-weight: 600; color: #09090b; }
                    GridLayout {
                        spacing-horizontal: 16px;
                        spacing-vertical: 8px;
                        Row { InfoLabel { text: "主机"; } InfoValue { text: root.hostname; } }
                        Row { InfoLabel { text: "策略"; } InfoValue { text: root.rev-text; } }
                        Row { InfoLabel { text: "壁纸"; } InfoValue { text: root.wallpaper-locked ? "已锁定" : "未锁定"; } }
                        Row { InfoLabel { text: "U 盘"; } InfoValue { text: root.usb-text; } }
                    }
                }
            }

            if root.message != "" : Text {
                text: root.message; color: #2563eb; font-size: 12px; wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 10px;
                Button { height: 38px; text: "隐藏到托盘"; horizontal-stretch: 1;
                         clicked => { root.hide-window(); } }
            }

            if root.admin-mode : Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 14px; spacing: 8px;
                    Text { text: "管理员模式"; font-size: 15px; font-weight: 700; color: #18181b; }
                    ScrollView {
                        height: 275px;
                        VerticalLayout {
                            spacing: 8px;
                            CheckBox { text: "锁定壁纸"; checked <=> root.admin-lock-wallpaper; }
                            LineEdit { placeholder-text: "本机壁纸路径（可留空）"; text <=> root.admin-wallpaper-path; }
                            HorizontalLayout {
                                Text { text: "U 盘"; vertical-alignment: center; }
                                ComboBox { model: ["允许", "只读", "禁用"]; current-value <=> root.admin-usb; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                Text { text: "还原保护 UWF"; vertical-alignment: center; }
                                ComboBox { model: ["开启", "关闭", "不管理"]; current-value <=> root.admin-uwf; horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                Text { text: "保护范围"; vertical-alignment: center; }
                                ComboBox { model: ["仅系统盘", "所有固定磁盘"]; current-value <=> root.admin-uwf-scope; horizontal-stretch: 1; }
                            }
                            CheckBox { text: "禁用任务管理器"; checked <=> root.admin-task-manager; }
                            CheckBox { text: "禁止互联网访问（保留局域网）"; checked <=> root.admin-block-internet; }
                            LineEdit { placeholder-text: "新的客户端访问密码（留空则不变）";
                                       input-type: password; text <=> root.admin-new-passphrase; }
                            LineEdit { placeholder-text: "默认壁纸的本机路径（可留空）";
                                       text <=> root.admin-default-wallpaper-path; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "保存本机设置"; enabled: !root.busy; clicked => { root.admin-save(); } }
                        Button { text: "一键恢复初始状态"; enabled: !root.busy; clicked => { root.admin-restore(); } }
                    }
                    Button { text: "恢复桌面默认（鼠标、图标、壁纸）"; enabled: !root.busy;
                             clicked => { root.admin-defaults(); } }
                    Text { text: "一键恢复会在 60 秒后重启；请先保存其他程序中的工作。";
                           font-size: 11px; color: #71717a; wrap: word-wrap; }
                }
            }
            }
        }

        Rectangle { vertical-stretch: 1; }
        Rectangle {
            height: 24px;
            about-text := Text { text: "关于"; font-size: 12px; color: #a1a1aa;
                                 horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.about-clicked(); } }
        }
    }

    if root.admin-dialog-open : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000080;
        TouchArea { width: parent.width; height: parent.height; }
        VerticalLayout {
            alignment: center;
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
            Card {
                width: 360px;
                horizontal-stretch: 0;
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    Text { text: "管理员验证"; font-size: 16px; font-weight: 700; }
                    LineEdit { placeholder-text: "管理员密码"; input-type: password;
                               text <=> root.admin-password;
                               accepted => { root.admin-unlock(root.admin-password); } }
                    if root.admin-error != "" : Text { text: root.admin-error; color: #dc2626; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Button { text: "取消"; clicked => { root.admin-dialog-open = false; root.admin-password = ""; } }
                        Button { text: "进入"; primary: true;
                                 clicked => { root.admin-unlock(root.admin-password); } }
                    }
                }
            }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    try-submit => {
        if (root.first-run && root.pw != root.pw2) {
            root.message = "两次输入不一致";
        } else if (root.pw == "") {
            root.message = "请输入密码";
        } else {
            root.message = "";
            root.unlock(root.pw);
        }
    }
}
